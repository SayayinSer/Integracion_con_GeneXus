        <Source><![CDATA[Categoria_SDT From Categoria
where CategoriaCodigo = &CategoriaCodigo 
{
	CategoriaCodigo  /*Concepto Caja Id value*/
	CategoriaNombre  /*Concepto Caja Nombre value*/
	ExisteSioNo = SioNo.Si /*Existe Sio No value*/
}
Categoria_SDT [Default]
{
	ExisteSioNo = SioNo.No /*Existe Sio No value*/
}
]]></Source>
