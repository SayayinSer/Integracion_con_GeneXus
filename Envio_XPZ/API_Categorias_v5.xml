      <Part type="9f577ec2-27f4-4cf4-8ad5-f3f50c9d69b5">
        <Source><![CDATA[ApiCategoria
{
	[Description("Recupera la Lista de Conceptos de Caja cargados.")]
	[RestMethod(GET)]
	Listar(in:&Buscar_CategoriaNombre, out:&CategoriaListaSDT)
 => CategoriaLista_DP(in:&Buscar_CategoriaNombre,out:&CategoriaListaSDT);
 
 	[Description("Recupera un Conceptos de Caja")]
 	[RestMethod(GET)]
 	Buscar(in:&Buscar_CategoriaCodigo, out:&CategoriaSDT)
 => Categoria_DP(in:&Buscar_CategoriaCodigo,out:&CategoriaSDT);
 
 	[Description("Graba un Nuevo de Conceptos de Caja")]
 	[RestMethod(POST)]
 	Insertar(in:&Buscar_CategoriaNombre, out:&Messages)
 => Categoria_Insertar(in:&Buscar_CategoriaNombre,out:&Messages);
 
 	[Description("Modificar un Conceptos de Caja existente")]
 	[RestMethod(PUT)]
 	Modificar(in:&Buscar_CategoriaCodigo,in:&Buscar_CategoriaNombre, out:&Messages)
 => Categoria_Modificar(in:&Buscar_CategoriaCodigo,in:&Buscar_CategoriaNombre,out:&Messages);
 
 	[Description("Borrar un Conceptos de Caja existente")]
 	[RestMethod(DELETE)]
 	Borrar(in:&Buscar_CategoriaCodigo,out:&Messages)
 => Categoria_Borrar(in:&Buscar_CategoriaCodigo,out:&Messages);
	}]]></Source>
        <Properties><Property><Name>IsDefault</Name><Value>False</Value></Property></Properties>
      </Part>
      <Part type="c44bd5ff-f918-415b-98e6-aca44fed84fa">
        <Source><![CDATA[Event Insertar.Before
	  if &Buscar_CategoriaNombre.IsEmpty()
        &RestCode = 412
        return
    endif
Endevent

Event Buscar.Before
	  if &Buscar_CategoriaCodigo <= 0
        &RestCode = 412
        return
    endif
Endevent

Event Modificar.Before
	  if &Buscar_CategoriaCodigo <= 0
        &RestCode = 412
        return
    endif
Endevent

Event Borrar.Before
	 if &Buscar_CategoriaCodigo <= 0
        &RestCode = 412
        return
    endif
Endevent
]]></Source>
