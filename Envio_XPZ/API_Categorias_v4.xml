        <Source><![CDATA[/////////////////////////////
// Borrar Concepto de Caja

&Categoria.Load(&CategoriaCodigo)
&Categoria.Delete()
If &Categoria.Success()
	Commit
Else
	Rollback
Endif
// Devuelve mensajes
&Messages = &Categoria.GetMessages()
]]></Source>
