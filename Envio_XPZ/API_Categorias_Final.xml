    <Object fullyQualifiedName="Categoria_DP" guid="fe601440-109c-40da-8236-da8d16a46939" name="Categoria_DP" type="2a9e9aba-d2de-4801-ae7f-5e3819222daf" description="DP Categoria" parentGuid="739a892b-5720-447c-ae75-b9c7ebe36275" moduleGuid="afa47377-41d5-4ae8-9755-6f53150aa361">
      <Part type="1d8aeb5a-6e98-45a7-92d2-d8de7384e432">
        <Source><![CDATA[Categoria_SDT From Categoria where CategoriaCodigo = &CategoriaCodigo
{
    CategoriaCodigo
    CategoriaNombre
    ExisteSioNo = SioNo.Si
}
Categoria_SDT [Default]
{
    ExisteSioNo = SioNo.No
}]]></Source>
