      <Part type="c44bd5ff-f918-415b-98e6-aca44fed84fa">
        <Source><![CDATA[Event Insertar.Before
	  if &Buscar_CategoriaNombre.IsEmpty()
        &RestCode = 412
        return
    endif
Endevent

Event Buscar.Before
	  if &Buscar_CategoriaCodigo <= 0
        &RestCode = 412
        return
    endif
Endevent

Event Modificar.Before
	  if &Buscar_CategoriaCodigo <= 0
        &RestCode = 412
        return
    endif
Endevent

Event Borrar.Before
	 if &Buscar_CategoriaCodigo <= 0
        &RestCode = 412
        return
    endif
Endevent
]]></Source>
