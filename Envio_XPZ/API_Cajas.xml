    <!-- API: API_Cajas -->
    <Object fullyQualifiedName="API_Cajas" guid="500b0221-aa46-4e30-9eb4-64b108168cff" name="API_Cajas" type="36e32e2d-023e-4188-95df-d13573bac2e0" description="API Cajas" parentGuid="739a892b-5720-447c-ae75-b9c7ebe36275" moduleGuid="afa47377-41d5-4ae8-9755-6f53150aa361">
      <Part type="9f577ec2-27f4-4cf4-8ad5-f3f50c9d69b5">
        <Source><![CDATA[APICajas
{
    [RestMethod(GET)] [Path("/api/cajas")] Listar(out:&CajaListaSDT) => CajaLista_DP(out:&CajaListaSDT);
    [RestMethod(GET)] [Path("/api/cajas/{CajaId}")] Buscar(in:&CajaId, out:&Caja_SDT) => Caja_DP(in:&CajaId, out:&Caja_SDT);
    [RestMethod(POST)] [Path("/api/cajas")] Insertar(in:&CajaId, in:&CajaDescripcion, in:&CajaEstado, in:&CajaSaldoInicial, out:&Messages) => Caja_Insertar(in:&CajaId, in:&CajaDescripcion, in:&CajaEstado, in:&CajaSaldoInicial, out:&Messages);
    [RestMethod(PUT)] [Path("/api/cajas/{CajaId}")] Modificar(in:&CajaId, in:&CajaDescripcion, in:&CajaEstado, in:&CajaSaldoInicial, out:&Messages) => Caja_Modificar(in:&CajaId, in:&CajaDescripcion, in:&CajaEstado, in:&CajaSaldoInicial, out:&Messages);
    [RestMethod(DELETE)] [Path("/api/cajas/{CajaId}")] Borrar(in:&CajaId, out:&Messages) => Caja_Borrar(in:&CajaId, out:&Messages);
}]]></Source>
      </Part>
